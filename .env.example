# .env.example
# Copy this file to .env and fill in your actual values

# Database
DATABASE_URL="postgresql://username:password@host:5432/database?sslmode=require"

# JWT Authentication
JWT_SECRET="your-secret-key-generate-with-openssl-rand-base64-32"

# Application
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
SITE_NAME="Lewis Magangi Portfolio"

# Email (SMTP). Without it, emails are logged and skipped.
# Alerts (new client reviews) go to lewismagangi1@gmail.com. momanyilewis10@gmail.com is the backup,
# used only when sending to the first fails. Set these only to change them.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-specific-password"
CONTACT_EMAIL="your-email@gmail.com"
# ALERT_EMAIL="lewismagangi1@gmail.com"
# ALERT_EMAIL_BACKUP="momanyilewis10@gmail.com"

# Optional: File Upload (Cloudinary)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Optional: Analytics
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID="G-XXXXXXXXXX"

# Optional: Clerk Authentication (alternative to NextAuth)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
# Nightly job that closes transcript links after 60 days (vercel.json crons, midnight EAT).
# Vercel sends it as "Authorization: Bearer <CRON_SECRET>". Generate with: openssl rand -base64 32
CRON_SECRET="generate-a-long-random-string"
